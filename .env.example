# ============================================================
#  Telegram Forex & Gold Signal Bot - environment variables
#  Copy this file to ".env" and fill in your values.
# ============================================================

# --- Required ---------------------------------------------------------------
# Token from @BotFather
BOT_TOKEN=123456789:AAExampleTokenFromBotFather
# Comma-separated Telegram user IDs of admins (get yours from @userinfobot)
ADMIN_IDS=111111111,222222222
# Numeric channel IDs (start with -100). The bot must be an ADMIN of both channels.
VIP_CHANNEL_ID=-1001234567890
PUBLIC_CHANNEL_ID=-1009876543210

# --- Recommended --------------------------------------------------------------
# Bot username without @ (used for "Unlock VIP" deep-link buttons; auto-detected if empty)
BOT_USERNAME=
# Support/sales account (without @) shown in "Get VIP" buttons
SUPPORT_USERNAME=
# SQLite file location. On Render use a persistent disk path, e.g. /var/data/signal_bot.db
DB_PATH=data/signal_bot.db
LOG_LEVEL=INFO

# --- Markets ------------------------------------------------------------------
# Any of: XAUUSD,EURUSD,GBPUSD,USDJPY,AUDUSD
SYMBOLS=XAUUSD,EURUSD,GBPUSD,USDJPY,AUDUSD

# --- Scheduler (seconds) --------------------------------------------------------
AUTO_SCAN_ENABLED=true
SCAN_INTERVAL_SECONDS=300
TRACK_INTERVAL_SECONDS=60
VIP_EXPIRY_SCAN_SECONDS=600
INVALIDATION_CHECK_SECONDS=300
INVALIDATION_MIN_AGE_MINUTES=15

# --- Signal engine ----------------------------------------------------------------
ANALYSIS_CACHE_TTL=20
TV_MAX_RETRIES=3
TREND_MIN_SCORE=3
RSI_BUY_MAX=72
RSI_SELL_MIN=28
REQUIRE_TV_SUMMARY_CONFIRM=true
ATR_SL_MULTIPLIER=1.5
SL_BUFFER_PCT=0.0002
SL_MIN_PCT=0.0008
SL_MAX_PCT=0.0060
SIGNAL_COOLDOWN_MINUTES=60
MAX_ACTIVE_TRADES=3
MARKET_HOURS_FILTER=true
SIGNAL_CMD_COOLDOWN_SECONDS=8

# --- News guard ---------------------------------------------------------------------
NEWS_BLOCK_MINUTES_BEFORE=30
NEWS_BLOCK_MINUTES_AFTER=30
NEWS_CACHE_SECONDS=3600
NEWS_RETRY_SECONDS=600
# true  = keep generating signals if the calendar feed is unreachable
# false = pause signals while the calendar is unavailable (safer)
NEWS_FAIL_OPEN=true
# Only used by the XML fallback feed (its times are normally UTC)
NEWS_XML_UTC_OFFSET_HOURS=0

# --- Channel / VIP behaviour ------------------------------------------------------------
# Also post stop-loss results to the public channel (recommended for transparency)
PUBLIC_POST_LOSSES=false
NOTIFY_ADMINS_ON_START=true
VIP_EXPIRY_WARNING_DAYS=3
# Remove expired/revoked members from the VIP channel automatically
VIP_AUTO_KICK=true
